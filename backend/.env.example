# Copie este arquivo para .env e ajuste se quiser.
# Chave que o jogo precisa enviar no header X-API-Key (troque por uma sua).
COACH_API_KEY=ace-coach-local
# Onde o Ollama está rodando e qual modelo usar
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
# Tempo máximo (segundos) esperando o modelo
OLLAMA_TIMEOUT=30
